@page
@model RazorPagesApp.Pages.StylesModel

<section class="mt-5">
    <div class="container">
        <div class="card shadow-sm p-4 mb-4">
            <h1 class="mb-4">Список завдань</h1>
            
            <div class="mb-3">
                <label class="form-label fw-bold">Назва завдання</label>
                <input class="form-control" type="text" required>
            </div>
            
            <div class="mb-3">
                <label class="form-label fw-bold">Опис завдання</label>
                <textarea class="form-control" rows="3" required></textarea>
            </div>
            
            <button class="btn btn-primary">Створити завдання</button>
        </div>
        <ul class="list-group"></ul>
    </div>
</section>