@page
@model RazorPagesApp.Pages.StylesModel
<section class="section">
    <div class="container">
        <div class="request">
            <h1 class="request__heading">To do list</h1>
            <div class="request__card">
                <span class="request__name">Task name</span>
                <input class="request__input-name" type="text" required>
            </div>
            <div class="request__card">
                <span class="request__tittle">Task tittle</span>
                <textarea class="request__input-tittle" rows="3" required></textarea>
            </div>
            <button class="request__button">Create task</button>
        </div>
        <ul class="tasks"></ul>
    </div>
</section>