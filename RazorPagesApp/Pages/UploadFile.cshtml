@page
@model RazorPagesApp.Pages.UploadFileModel

@{
    ViewData["Title"] = "Додавання файлу";
}
<div class="mt-4">
    <h3 class="mb-3">Оберіть файл для завантаження</h3>

    @* Завдяки встановленню атрибута форми enctype="multipart/form-data" 
       браузер знатиме, що разом із формою треба передати файл. *@

    <form method="post" enctype="multipart/form-data" class="mb-5">
        <div class="input-group mb-3 w-50">
            <input type="file" class="form-control" name="UploadedFile" id="inputGroupFile02">
            <button class="btn btn-primary" type="submit" for="inputGroupFile02">Завантажити</button>
        </div>
    </form>

    <h3 class="mb-3">Всі файли</h3>
    <div class="row">
        @foreach (var f in Model.FileModels)
        {
            <div class="col-md-3 mb-3">
                <div class="card shadow-sm">
                    <img src="@Url.Content(f.Path)" class="card-img-top" alt="@f.Name">
                </div>
            </div>
        }
    </div>
</div>