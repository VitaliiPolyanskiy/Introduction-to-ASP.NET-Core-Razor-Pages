<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Мій ASP.NET Додаток</title>
    <!-- Сучасний Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/normalize.css">
    <link rel="stylesheet" href="~/css/style.css">
    <script src="~/JS/script.js" defer></script>
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" href="/Index">Головна</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Square?a=10&h=20">Площа</a></li>
                    <li class="nav-item"><a class="nav-link" href="/DownloadFile">Завантажити файл</a></li>
                    <li class="nav-item"><a class="nav-link" href="/UploadFile">Відправити файл</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Image">Зображення</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Styles">Стилі</a></li>
                    <li class="nav-item"><a class="nav-link" href="/OldPage">Стара сторінка</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container flex-grow-1">
        @RenderBody()
    </div>

    <footer class="border-top footer text-muted py-3 mt-auto">
        <div class="container">
            &copy; @DateTime.Now.Year - Мій ASP.NET Додаток
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</body>
</html>