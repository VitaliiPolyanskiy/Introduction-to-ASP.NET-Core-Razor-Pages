@page
@model RazorPagesApp.Pages.ImageModel

<div>
    <h1 style="text-align:center; padding-top:40px">@Model.Message</h1>
    <p style="text-align:center"><img src="~/Images/ASP.NET Core MVC.png" /> </p>
    <p style="text-align:center">
        <audio id="drums" controls>
            <source src="/sounds/ogg/drums.ogg" type="audio/ogg">
            <source src="/sounds/mp3/drums.mp3" type="audio/mpeg">
        </audio>
    </p>
</div>